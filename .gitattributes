# Windows launchers must stay CRLF no matter how the repo is cloned:
# cmd.exe tolerates LF in most lines but breaks on `goto`/labels, and the
# PowerShell/vbs chain assumes CRLF. Everything else normalizes to LF.
* text=auto
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf

# binaries: no eol conversion, no diff
*.png binary
*.apk binary
*.jar binary
